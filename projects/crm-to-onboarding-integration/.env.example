# Copy to .env and edit.  (.env is in .gitignore: never commit secrets.)

# Shared secret used to sign webhooks (sender and receiver must match)
WEBHOOK_SECRET=change-me-local-dev-secret

# mock = fake Odoo stored in data/mock_odoo.db (no account needed)
# live = real Odoo via XML-RPC (Docker or an Odoo Online trial)
ODOO_MODE=mock
ODOO_URL=http://localhost:8069
ODOO_DB=onboarding
ODOO_USER=admin
ODOO_API_KEY=

# Mock only: fraction of calls that fail with a simulated 429 (try 0.3 to watch retries)
MOCK_FAILURE_RATE=0

# Stage 3 (optional): HubSpot private app token
HUBSPOT_TOKEN=
